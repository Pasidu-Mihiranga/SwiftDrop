# =====================================================================
# SwiftDrop — environment template
# Copy to .env with:  pnpm env:init   (generates random values for every
# variable whose value is "__generate__"). Never commit the real .env.
# =====================================================================

COMPOSE_PROJECT_NAME=swiftdrop

# ---------- Host ports (change if something else on your machine already uses them) ----------
# Avoid Windows reserved ranges (see: netsh interface ipv4 show excludedportrange protocol=tcp).
# Containers always talk to each other on the internal Docker network; these only affect your machine.
KEYCLOAK_HOST_PORT=8180
POSTGRES_HOST_PORT=15432
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380
OSRM_HOST_PORT=15000
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8088
S3_HOST_PORT=9010
S3_CONSOLE_HOST_PORT=9011
MAILPIT_UI_HOST_PORT=8026
MAILPIT_SMTP_HOST_PORT=1026
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
GRAFANA_HOST_PORT=3001
GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000

# ---------- PostgreSQL (one instance, one database + user per service) ----------
POSTGRES_USER=swiftdrop_admin
POSTGRES_PASSWORD=__generate__
# Password shared by the per-service DB users in local dev (each service still has its own user/database)
SWIFTDROP_DB_PASSWORD=__generate__
KEYCLOAK_DB_PASSWORD=__generate__

# ---------- MongoDB ----------
MONGO_ROOT_USER=swiftdrop
MONGO_ROOT_PASSWORD=__generate__

# ---------- Redis ----------
REDIS_PASSWORD=__generate__

# ---------- Object storage (RustFS, S3-compatible) ----------
S3_ACCESS_KEY=swiftdrop
S3_SECRET_KEY=__generate__
S3_BUCKET_PROOFS=swiftdrop-proofs

# ---------- Keycloak ----------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__generate__
# URL the browser uses (port = KEYCLOAK_HOST_PORT). It is also the token issuer (iss) — keep it identical everywhere.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=swiftdrop
KC_WEB_CLIENT_SECRET=__generate__
KC_USER_SERVICE_CLIENT_SECRET=__generate__
KC_MERCHANT_SERVICE_CLIENT_SECRET=__generate__
KC_DEMO_MERCHANT_CLIENT_SECRET=__generate__
# Merchant simulator (M8): page on this port; signing secret of its webhook endpoint (optional, can be pasted on its page)
MERCHANT_SIMULATOR_HOST_PORT=4010
MERCHANT_SIMULATOR_WEBHOOK_SECRET=
# Password for the seeded demo users (admin@, dispatcher@, courier1@, courier2@, customer@, merchant@swiftdrop.lk)
KC_SEED_USER_PASSWORD=Swift@2026
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: http://localhost:8180/realms/swiftdrop/broker/google/endpoint
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured

# ---------- Web (Next.js + Auth.js) ----------
AUTH_SECRET=__generate__
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=swiftdrop-web
# Backend gateway as seen from the Next.js server
GATEWAY_URL=http://localhost:8080
# Tiles for the optional map on /quote. Leave MAP_TILE_URL blank to hide the map. The public
# OpenStreetMap server is fine for local development only; its usage policy rules out
# production traffic, so production needs its own or a commercial tile service.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="Map data (c) OpenStreetMap contributors"
# Gateway as seen from the browser (live tracking socket at /ws/tracking; public, no secret)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ---------- Security ----------
# 32-byte base64 key for AES-GCM encryption of PII columns (phones, addresses)
PII_ENCRYPTION_KEY=__generate_base64_32__

# ---------- AI assistant ----------
# gemini (AI Studio API key) | openai | vertex (Gemini on Vertex AI with a service account)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
# Vertex AI: put the service account key at secrets/google-service-account.json (git- and docker-ignored);
# the path is relative to the repository root. The service account needs the "Vertex AI User" role.
VERTEX_CREDENTIALS_FILE=secrets/google-service-account.json
VERTEX_LOCATION=global
# Encrypts the assistant's per-conversation PII vault (placeholder -> real value)
ASSISTANT_VAULT_SECRET=__generate__
# Personal data in MCP tool results is masked; set to false only for trusted MCP clients
MCP_MASK_PII=true

# ---------- Observability ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__generate__

# ---- Road routing (optional) ---------------------------------------------------------------
# Same-day distances. Leave blank to run without a router: they are then estimated and labelled.
# After "pnpm routing:up": http://localhost:15000 for a service on this machine,
# http://osrm:5000 for one running in Compose.
OSRM_URL=
