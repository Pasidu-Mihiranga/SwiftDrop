{
  "name": "@swiftdrop/common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared building blocks for SwiftDrop Node services: event contracts + validation, Kafka consumer template, JWT verification, PII-masking logger, problem+json, NestJS module.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-contracts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --coverage"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "5.10.0",
    "kafkajs": "2.2.4",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true },
    "reflect-metadata": { "optional": true },
    "rxjs": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
