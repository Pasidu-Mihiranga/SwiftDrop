{
  "name": "@swiftdrop/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end demo suite, run against the full compose stack (pnpm stack:up).",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report ../../doc/test-reports/e2e/html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
