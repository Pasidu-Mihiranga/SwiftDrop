%% Courier use cases (M4). Mermaid has no use-case diagram, so actors are drawn as rounded nodes
%% and use cases as stadium nodes inside the system boundary.
flowchart LR
  courier(["Courier<br/>(role COURIER)"])
  dispatcher(["Dispatcher / Admin<br/>(role DISPATCHER, ADMIN)"])
  storage(["Object storage<br/>(RustFS, S3 API)"])

  subgraph system["SwiftDrop courier operations"]
    direction TB
    uc1(["View daily run sheet"])
    uc2(["Open an assigned parcel"])
    uc3(["Update parcel status<br/>pickup, transit, out for delivery"])
    uc4(["Mark delivered with proof"])
    uc5(["Upload proof photo<br/>JPEG/PNG up to 5 MB"])
    uc6(["Mark delivery failed with reason"])
    uc7(["Re-attempt a failed delivery"])
    uc8(["View proof of delivery"])
  end

  courier --> uc1
  courier --> uc2
  courier --> uc3
  courier --> uc4
  courier --> uc6
  uc4 -. "includes (photo proof)" .-> uc5
  uc5 --> storage
  dispatcher --> uc3
  dispatcher --> uc7
  dispatcher --> uc8
  uc8 --> storage
