%%{init: {"theme":"base","themeVariables":{"primaryColor":"#ffffff","primaryBorderColor":"#000000","primaryTextColor":"#000000","lineColor":"#000000","background":"#ffffff","fontFamily":"Arial"}}}%%
%% M6 event-processing activity: one parcel event through the consumer. Editable source for
%% activity-m6-event-processing.svg / .png (hand-drawn export with swimlanes).
flowchart TD
    S((start)) --> R["receive event, key = parcelId"]
    R --> V{"valid envelope?"}
    V -- "no" --> DLQ["dead-letter topic"]
    V -- "yes" --> D{"eventId seen?"}
    D -- "yes" --> SK["skip event, commit offset"]
    D -- "no" --> ST{"older than lastChangedAt?"}
    ST -- "yes" --> SK
    ST -- "no" --> TX["upsert timeline and processed_event in one transaction"]
    TX --> E{"handler error?"}
    E -- "yes, attempt < 3: backoff and retry" --> TX
    E -- "error after 3 attempts" --> DLQ
    E -- "no" --> EM["emit parcel.status to rooms"]
    EM --> CO["commit offset"]
    CO --> END((end))
