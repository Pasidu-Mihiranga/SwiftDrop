%% M6 activity: how one Kafka message becomes a timeline update and a live push.
%% Idempotent consumer (eventId in processed_events) plus out-of-order guard (lastChangedAt).
%% Retry and dead-letter steps follow the shared consumer template in libs/node/swiftdrop-common.
flowchart TD
    S(["Kafka message<br/>parcel.* topic, key = parcelId"]) --> V{"Envelope valid<br/>against JSON Schema?"}
    V -- "no [invalid]" --> BAD["Log with PII masking, count metric,<br/>record in dead-letter"]
    BAD --> ACK1(["Commit offset"])
    V -- "yes" --> D{"eventId already in<br/>processed_events?"}
    D -- "yes [duplicate]" --> ACK2(["Commit offset, no change"])
    D -- "no" --> O{"changedAt older than<br/>lastChangedAt? [out-of-order]"}
    O -- "yes [late]" --> APP["Append event to history only,<br/>currentStatus is not moved back"]
    O -- "no [in order]" --> SET["Set currentStatus, lastChangedAt,<br/>publicView and ownerIds"]
    APP --> TX
    SET --> TX["Mongo transaction:<br/>upsert timeline + insert processed_events"]
    TX -- "error" --> R{"attempt below 3?"}
    R -- "yes [retry]" --> BO["Exponential backoff,<br/>redeliver the message"]
    BO --> D
    R -- "no [exhausted]" --> DLQ["Dead-letter record and alert"]
    DLQ --> ACK1
    TX -- "ok" --> CHG{"currentStatus changed?"}
    CHG -- "yes" --> EMIT["Broadcast parcel.status<br/>to tracking, user and dispatch rooms"]
    CHG -- "no" --> ACK3
    EMIT --> ACK3(["Commit offset"])
