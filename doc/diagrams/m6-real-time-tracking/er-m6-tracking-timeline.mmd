%% M6 data model: MongoDB documents in database tracking (CQRS read model, not a relational schema).
%% Cross-service references are IDs only (parcelId, ownerIds), never foreign keys.
%% publicView is the only part served to guests; it has no phone and no street address.
erDiagram
    TIMELINE {
        ObjectId _id PK
        string trackingNumber UK "SD + base32 + check, unique"
        string parcelId UK "UUID from parcel-service"
        string ownerIds "customerId, merchantId, courierId"
        string currentStatus "parcel status enum"
        date lastChangedAt "guards out-of-order events"
        int version "optimistic concurrency"
        date updatedAt
    }
    TIMELINE_EVENT {
        string eventId "envelope eventId, unique in timeline"
        string eventType "ParcelCreated, ParcelStatusChanged, ParcelAssigned"
        string fromStatus
        string toStatus
        string failureReason "enum, when FAILED"
        string note "max 500"
        string actorRole
        date changedAt
    }
    PUBLIC_VIEW {
        string city "district-level only"
        string maskedRecipient "K*** P. style"
        string currentStatus
    }
    PROCESSED_EVENT {
        string eventId PK "unique index"
        string consumer "consumer name"
        date processedAt "TTL index, 30 days"
    }

    TIMELINE ||--o{ TIMELINE_EVENT : "embeds events[]"
    TIMELINE ||--|| PUBLIC_VIEW : "embeds publicView"
    TIMELINE_EVENT }o..o| PROCESSED_EVENT : "dedupe by eventId"
