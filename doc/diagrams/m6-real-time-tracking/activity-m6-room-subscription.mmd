%% M6 activity: decision flow for a socket join request (RoomPolicy).
%% Every join is checked on the server; the client's choice of room is never trusted.
flowchart TD
    S(["join request<br/>room name in payload"]) --> T{"Handshake has auth.token?"}
    T -- "no [anonymous]" --> P{"Room starts with tracking:?"}
    P -- "yes" --> OK1["Join room (public)"]
    P -- "no" --> NO1["Reply error forbidden"]
    T -- "yes" --> JV{"Signature, issuer, audience<br/>and expiry valid?"}
    JV -- "no [invalid]" --> DC["Disconnect, reply connect_error"]
    JV -- "yes" --> K{"Room kind"}
    K -- "tracking:TRACKING_NO" --> OK2["Join room (public)"]
    K -- "user:SUB" --> Q{"SUB equals token sub?"}
    Q -- "yes [owner]" --> OK3["Join room"]
    Q -- "no [another user]" --> NO2["Reply error forbidden,<br/>log the attempt without PII"]
    K -- "dispatch" --> R{"Role DISPATCHER or ADMIN?"}
    R -- "yes" --> OK4["Join room (staff)"]
    R -- "no" --> NO3["Reply error forbidden"]
    K -- "unknown room" --> NO4["Reply error not_found"]
    OK1 --> DONE(["Done"])
    OK2 --> DONE
    OK3 --> DONE
    OK4 --> DONE
    NO1 --> DONE
    NO2 --> DONE
    NO3 --> DONE
    NO4 --> DONE
