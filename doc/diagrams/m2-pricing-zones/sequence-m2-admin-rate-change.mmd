%% M2 key flow 3: an admin changes the price of a lane.
%% Rate cards are versioned, never edited: the card in force is closed and a new one added.
%% Quotes already issued keep their fee, because each holds its own Redis snapshot.
sequenceDiagram
    autonumber
    actor A as Admin (browser)
    participant UI as /admin/pricing/rate-cards
    participant SA as Server actions<br/>closeRateCard / createRateCard
    participant GW as api-gateway
    participant ARC as AdminRateCardController<br/>@PreAuthorize hasRole('ADMIN')
    participant RAS as RateCardAdminService
    participant ZR as ZoneRepository
    participant RR as RateCardRepository
    participant PG as Postgres pricing_db
    participant RD as Redis (issued snapshots)

    A->>UI: open the rate-card editor
    UI->>GW: GET /api/v1/admin/pricing/rate-cards?zone=&effectiveOn=
    GW->>ARC: forward (ADMIN token)
    ARC-->>UI: paged cards with their effective periods

    A->>UI: close the card in force on 2026-11-01
    UI->>SA: closeRateCard(rateCardId, effectiveTo)
    SA->>GW: PUT /api/v1/admin/pricing/rate-cards/{id}/closure
    GW->>ARC: forward
    alt caller is not ADMIN
        ARC-->>SA: 403 problem+json
    else caller is ADMIN
        ARC->>RAS: close(rateCardId, effectiveTo)
        RAS->>RR: findById(rateCardId)
        alt no such card
            RAS-->>ARC: 404 Rate card not found
        else effectiveTo is not after effectiveFrom
            RAS-->>ARC: 422 INVALID_EFFECTIVE_RANGE
        else valid
            RAS->>RR: save(existing.closedOn(effectiveTo))
            RR->>PG: UPDATE rate_card SET effective_to = ...
            Note over RR,PG: never a DELETE - the card stays on record<br/>so an issued quote remains auditable
            RAS-->>ARC: the closed card
            ARC-->>UI: 200
        end
    end

    A->>UI: publish the new price from 2026-11-01
    UI->>SA: createRateCard(...)
    SA->>GW: POST /api/v1/admin/pricing/rate-cards
    GW->>ARC: forward
    ARC->>RAS: create(fromZone, toZone, fees, effectiveFrom, effectiveTo)
    RAS->>ZR: existsByCode(fromZone) / existsByCode(toZone)
    alt a zone does not exist
        RAS-->>ARC: 404 Zone not found
    else zones exist
        RAS->>RAS: build RateCard (domain invariants -> 422 INVALID_RATE_CARD)
        RAS->>RR: findByPair(fromZone, toZone)
        RAS->>RAS: rejectOverlap - periods are half-open,<br/>so one card ending the day another starts is fine
        alt an overlapping card is already in force
            RAS-->>ARC: 409 RATE_CARD_OVERLAP
        else no overlap
            RAS->>RR: save(candidate)
            RR->>PG: INSERT INTO rate_card
            RAS-->>ARC: the new card
            ARC-->>UI: 201
            UI-->>A: both periods shown, no gap and no overlap
        end
    end

    Note over RD: untouched by the change - a quote issued<br/>yesterday is still returned at its original fee<br/>until its own TTL expires
