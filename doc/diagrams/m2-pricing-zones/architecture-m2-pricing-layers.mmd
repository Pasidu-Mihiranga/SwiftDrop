%% M2 architecture: where pricing-service sits, and its internal layering.
%% Style (inherited from doc/01-architecture.md): microservices behind an API gateway,
%% with Next.js acting as the BFF. Each service is internally layered / hexagonal.
%% Dependencies point inwards only: api -> application -> domain; infrastructure
%% implements the application's outbound ports.
flowchart TB
    classDef pres fill:#eef4ff,stroke:#3b5bdb,color:#1b2a5e
    classDef app fill:#fff4e6,stroke:#e8590c,color:#7f2d00
    classDef dom fill:#ebfbee,stroke:#2f9e44,color:#14532d
    classDef infra fill:#f3f0ff,stroke:#7048e8,color:#3c2a85
    classDef store fill:#f8f9fa,stroke:#868e96,color:#343a40
    classDef ext fill:#fff5f5,stroke:#e03131,stroke-dasharray:4 3,color:#7a1212

    subgraph PRESENTATION["PRESENTATION LAYER"]
        direction TB
        BROWSER["Browser<br/>/quote page + fee-estimate widget<br/>/admin/pricing/{zones,rate-cards}"]:::pres
        WEBLIB["apps/web/src/lib<br/>pricing.ts - form validation, labels,<br/>district coverage<br/>pricing-api.ts - pricing-actions.ts"]:::pres
        BFF["Next.js BFF<br/>/api/bff/[...path]<br/>attaches the access token server-side"]:::pres
        GW["api-gateway :8080<br/>Spring Cloud Gateway - JWT via Keycloak JWKS<br/>route: /api/v1/pricing/**, /api/v1/admin/pricing/**"]:::pres
        subgraph CTRL["pricing-service :8083 - api package"]
            QC["QuoteController<br/>POST /quotes - GET /quotes/{id}"]:::pres
            ZC["ZoneController<br/>GET /pricing/zones (public)"]:::pres
            AZC["AdminZoneController<br/>zones + districts"]:::pres
            ARC["AdminRateCardController<br/>list, get, create, PUT /closure"]:::pres
            ASC["AdminSizeClassController"]:::pres
            DTO["dto + mapper<br/>Bean Validation at the boundary<br/>problem+json error responses"]:::pres
        end
    end

    subgraph BUSINESS["BUSINESS LOGIC LAYER"]
        direction TB
        subgraph APPL["application - use-case orchestration (Spring, @Transactional)"]
            QIS["QuoteIssuanceService<br/>stores the snapshot before answering"]:::app
            QPS["QuotePricingService<br/>resolves coverage + size limits"]:::app
            RCS["RateCardSelectionService<br/>newest in force wins; a tie is AMBIGUOUS_RATE_CARD"]:::app
            QLS["QuoteLookupService<br/>404 for unknown or expired"]:::app
            ADMIN_SVC["ZoneAdminService - RateCardAdminService<br/>SizeClassAdminService - RateCardQueryService<br/>ZoneQueryService"]:::app
            PORTS["port/out (interfaces only)<br/>ZoneRepository - DistrictAssignmentRepository<br/>RateCardRepository - SizeClassRepository - QuoteStore"]:::app
        end
        subgraph DOMAIN["domain - plain Java, no framework types"]
            POLICY["policy: FeeCalculator<br/>PricingStrategy + PricingDecorator<br/>ZoneMatrix / Weight / Size / Express / Cod"]:::dom
            MODEL["model: Zone - ZoneCode - RateCard<br/>SizeClassRate - DistrictAssignment<br/>FeeBreakdown - PricingRule - MonetaryRounding<br/>ServiceLevel - SizeClassCode"]:::dom
        end
    end

    subgraph DATA["DATA LAYER"]
        direction TB
        subgraph ADAPTERS["infrastructure - outbound adapters"]
            JPA["*RepositoryAdapter + *JpaRepository<br/>*Entity + PricingPersistenceMapper"]:::infra
            REDISA["RedisQuoteStore<br/>SET with the remaining TTL"]:::infra
            CLOCKC["PricingClockConfiguration<br/>Clock used for issue and expiry times"]:::infra
        end
        PG[("Postgres pricing_db<br/>9 zones, 25 districts,<br/>4 size classes, 81 rate cards")]:::store
        RD[("Redis<br/>quote snapshots, TTL PT15M")]:::store
    end

    PARCEL["parcel-service<br/>validates a quoteId before booking"]:::ext
    KC["Keycloak 26<br/>OIDC / OAuth 2.0 - realm role ADMIN"]:::ext

    BROWSER --> WEBLIB --> BFF --> GW
    GW --> QC & ZC & AZC & ARC & ASC
    PARCEL -->|"bearer token"| GW
    GW -.->|"JWKS, token validation"| KC

    QC --> DTO
    QC --> QIS
    QC --> QLS
    ZC --> ADMIN_SVC
    AZC --> ADMIN_SVC
    ARC --> ADMIN_SVC
    ASC --> ADMIN_SVC

    QIS --> QPS --> RCS
    QPS --> POLICY
    POLICY --> MODEL
    QIS --> PORTS
    QLS --> PORTS
    QPS --> PORTS
    RCS --> PORTS
    ADMIN_SVC --> PORTS
    ADMIN_SVC --> MODEL

    JPA -. implements .-> PORTS
    REDISA -. implements .-> PORTS
    JPA --> PG
    REDISA --> RD
    CLOCKC --> QIS
    CLOCKC --> QLS
