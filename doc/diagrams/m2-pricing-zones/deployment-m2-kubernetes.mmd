%% M2 Kubernetes / Helm deployment topology.
%% .
%% STATUS: BUILT AND DEPLOYED. infra/helm holds the library chart, twelve thin service
%% charts and the umbrella chart. The dev slice shown in green was installed on a kind
%% cluster and exercised end to end; see the Phase 4 verification section of
%% doc/04-m2-pricing-zones-issue-15.md for what was proven and what was not.
%% .
%% One deviation from the Phase 0 decision: Postgres, Redis and Keycloak are templated by
%% the umbrella chart rather than pulled in as subcharts, so the images are the ones
%% docker-compose.yml already pins and a kind cluster needs no registry access. Strimzi and
%% RustFS remain documented prerequisites.
%% M2's deployment ownership is the chart structure itself plus pricing-service's own chart;
%% the other service pods are shown for context and are owned by their milestones.
flowchart TB
    classDef chart fill:#f3f0ff,stroke:#7048e8,color:#3c2a85
    classDef mine fill:#ebfbee,stroke:#2f9e44,stroke-width:2px,color:#14532d
    classDef pod fill:#ffffff,stroke:#868e96,color:#343a40
    classDef store fill:#f8f9fa,stroke:#495057,color:#212529
    classDef edge fill:#eef4ff,stroke:#3b5bdb,color:#1b2a5e
    classDef prereq fill:#fff9db,stroke:#f08c00,stroke-dasharray:4 3,color:#7a4a00

    USER(["Internet"]):::edge

    subgraph HELM["Helm chart structure (M2 deliverable, DRY)"]
        direction LR
        LIB["swiftdrop-service<br/><b>library chart</b><br/>Deployment, Service, ConfigMap,<br/>Secret refs, probes, optional HPA"]:::chart
        UMB["swiftdrop<br/><b>umbrella chart</b><br/>values-dev.yaml / values-prod.yaml"]:::chart
        THIN["charts/&lt;service&gt;<br/>thin per-service charts<br/>incl. charts/pricing-service"]:::mine
        UMB --> THIN --> LIB
    end

    subgraph CLUSTER["Kubernetes cluster (kind / minikube for dev)"]
        direction TB
        ING["Ingress (NGINX)<br/>TLS, environment-specific hosts<br/>web / api / auth / grafana"]:::edge

        subgraph NS["namespace: swiftdrop"]
            direction TB
            WEB["Deployment web<br/>Next.js + BFF :3000"]:::pod
            GW["Deployment api-gateway<br/>:8080, HPA"]:::pod

            PRICE["<b>Deployment pricing-service</b><br/>:8083, 2+ replicas<br/>liveness / readiness: /actuator/health<br/>env from ConfigMap + Secret<br/>SPRING_DATASOURCE_*, REDIS_*,<br/>PRICING_QUOTE_TTL=PT15M"]:::mine
            OTHERS["Deployments: user, merchant, parcel,<br/>dispatch, tracking, notification,<br/>webhook, reporting, ai-assistant<br/>(charts ready, disabled until their<br/>Kafka / Mongo / S3 prerequisites exist)"]:::pod

            SVCP["Service pricing-service<br/>ClusterIP :8083<br/>stateless, so any replica may answer"]:::mine
            CM["ConfigMap pricing-service<br/>non-secret config"]:::mine
            SEC["Secret pricing-service<br/>DB + Redis credentials<br/>externalised, never in Git"]:::mine

            subgraph DEPS["datastores, templated by the umbrella chart"]
                direction LR
                PG[("Postgres<br/>StatefulSet + PVC<br/>database pricing_db<br/>Flyway runs on startup")]:::store
                RD[("Redis<br/>quote snapshots, TTL PT15M")]:::store
                KC[("Keycloak 26<br/>OIDC / OAuth 2.0")]:::store
            end

            GRAF["Grafana + Prometheus<br/><b>SwiftDrop Pricing &amp; Zones</b> dashboard<br/>quotes issued, fee distribution,<br/>rate-card selection failures"]:::mine
        end

        subgraph PRE["documented prerequisites (not subcharts)"]
            direction LR
            STRIMZI["Strimzi / Kafka"]:::prereq
            RUSTFS["RustFS (S3)"]:::prereq
        end
    end

    USER --> ING
    ING -->|"web host"| WEB
    ING -->|"api host"| GW
    ING -->|"auth host"| KC
    ING -->|"grafana host"| GRAF
    WEB --> GW
    GW --> SVCP
    GW --> OTHERS
    SVCP --> PRICE
    CM --> PRICE
    SEC --> PRICE
    PRICE --> PG
    PRICE --> RD
    PRICE -.->|"JWT validation via JWKS"| KC
    PRICE -.->|"/actuator/prometheus<br/>pricing_quotes_issued_total<br/>pricing_quote_fee_LKR<br/>pricing_rate_card_selection_failures_total"| GRAF
    OTHERS -.-> STRIMZI
    OTHERS -.-> RUSTFS
    THIN -.->|"renders"| NS
