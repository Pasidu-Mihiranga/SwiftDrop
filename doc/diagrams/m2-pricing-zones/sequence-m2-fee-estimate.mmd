%% M2 key flow 1: anonymous fee estimate (POST /api/v1/pricing/quotes).
%% Public path - no bearer token. Integration pattern: synchronous request/reply.
sequenceDiagram
    autonumber
    actor G as Guest (browser)
    participant W as Fee-estimate widget<br/>+ apps/web/src/lib/pricing.ts
    participant B as Next.js BFF<br/>/api/bff/[...path]
    participant GW as api-gateway
    participant QC as QuoteController
    participant QIS as QuoteIssuanceService
    participant QPS as QuotePricingService
    participant DR as DistrictAssignmentRepository
    participant SR as SizeClassRepository
    participant RCS as RateCardSelectionService
    participant FC as FeeCalculator<br/>(Strategy + Decorator chain)
    participant RD as RedisQuoteStore

    G->>W: pick districts, weight, size class,<br/>service level, COD amount
    W->>W: validateQuoteForm(...) - client-side gate,<br/>districts come from GET /pricing/zones
    alt form invalid
        W-->>G: field errors, no request sent
    else form valid
        W->>B: POST /api/bff/v1/pricing/quotes
        B->>GW: POST /api/v1/pricing/quotes (anonymous allow-list)
        GW->>QC: forward
        QC->>QC: Bean Validation on QuoteRequest
        QC->>QIS: issue(input)
        QIS->>QIS: issuedAt = clock.instant()<br/>quoteDate = LocalDate.ofInstant(...)
        QIS->>QPS: prepare(input, quoteDate)
        QPS->>DR: findActiveZoneCodeByDistrict(fromDistrict)
        QPS->>DR: findActiveZoneCodeByDistrict(toDistrict)
        alt a district has no active zone
            DR-->>QPS: empty
            QPS-->>QC: BusinessRuleViolation DISTRICT_NOT_SERVICED
            QC-->>G: 422 problem+json
        else both districts covered
            QPS->>SR: findByCode(sizeClass)
            QPS->>QPS: sizeClass.accepts(weightKg)?
            alt weight over the class limit
                QPS-->>QC: SIZE_CLASS_WEIGHT_EXCEEDED
                QC-->>G: 422 problem+json
            else within the limit
                QPS->>RCS: select(fromZone, toZone, quoteDate)
                RCS-->>QPS: the rate card in force
                QPS->>FC: calculate(card, sizeClass, weightKg,<br/>serviceLevel, codAmount)
                FC-->>QPS: FeeBreakdown<br/>BASE, WEIGHT, SIZE, EXPRESS, COD + exact total
                QPS-->>QIS: PreparedQuote
                QIS->>QIS: build QuoteSnapshot<br/>quoteId = UUID.randomUUID()<br/>expiresAt = issuedAt + PT15M
                QIS->>RD: save(snapshot, remaining TTL)
                Note over QIS,RD: stored BEFORE the response is returned,<br/>so no quote is ever shown that cannot be looked up
                RD-->>QIS: ok
                QIS-->>QC: QuoteSnapshot
                QC-->>GW: 201 with fee, breakdown, zones, expiresAt
                GW-->>B: 201
                B-->>W: quote
                W->>W: onQuote(quote) - exposes quoteId<br/>for the M3 booking flow (handoff still open)
                W-->>G: itemised fee + expiry countdown
            end
        end
    end
