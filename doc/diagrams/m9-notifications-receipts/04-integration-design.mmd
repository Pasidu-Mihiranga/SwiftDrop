%% M9 integration design: asynchronous events in, synchronous queries out.
flowchart LR
    subgraph ASYNC["Asynchronous · events become messages"]
        P1["parcel-service<br/>merchant-service"] -- "1 transactional outbox" --> K1["Kafka topics"]
        K1 -- "2 publish / subscribe" --> C1["notification-service<br/>consumer group"]
        C1 -- "3 idempotent consumer<br/>consumer_idempotency" --> D1["Dispatcher"]
        D1 -- "4 strategy per channel" --> E1["E-mail · SMTP"]
        D1 --> S1["SMS · sms_outbox"]
        C1 -. "5 dead-letter channel" .-> DL["notification dead-letter topic"]
    end
    subgraph SYNC["Synchronous · request and reply"]
        W["Web pages + BFF"] -- "6 REST, bearer JWT" --> G["api-gateway"]
        G --> N2["notification-service<br/>bell, preferences, SMS inbox"]
        G --> R2["parcel-service<br/>history and PDF receipt"]
    end
