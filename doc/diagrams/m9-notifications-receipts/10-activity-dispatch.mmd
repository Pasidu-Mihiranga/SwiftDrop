%% M9 activity: how one event is turned into notifications.
flowchart TB
    S((" ")) --> R["Receive a Kafka event<br/>parcel or merchant topic"]
    R --> D1{"already processed?<br/>consumer_idempotency"}
    D1 -- "yes" --> ACK["Commit the offset<br/>send nothing"]
    ACK --> E1(((" ")))
    D1 -- "no" --> T{"event type"}
    T -- "MerchantLifecycleChanged" --> MT["Approval or rejection e-mail<br/>to the merchant"]
    T -- "ParcelCreated, ParcelStatusChanged" --> PR["Load contacts and preferences"]
    PR --> D2{"status opted in?"}
    D2 -- "no" --> LOG["Record as skipped"]
    D2 -- "yes" --> CH["Render the Handlebars template<br/>brand layout and tracking link"]
    CH --> EM["E-mail channel<br/>if e-mail is on"]
    CH --> SM["SMS channel<br/>if SMS is on"]
    MT --> SAVE
    EM --> SAVE["Save notification and log<br/>bell entry"]
    SM --> SAVE
    LOG --> SAVE
    SAVE --> D3{"send failed after retries?"}
    D3 -- "yes" --> DLQ["Publish to the dead-letter topic"]
    D3 -- "no" --> OK["Commit the offset"]
    DLQ --> OK
    OK --> E2(((" ")))
