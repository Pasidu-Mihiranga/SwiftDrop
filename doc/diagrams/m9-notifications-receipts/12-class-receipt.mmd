%% M9 class diagram: receipt generation in parcel-service.
classDiagram
    direction LR
    class ParcelController {
        +receipt(parcelId, jwt) ResponseEntity~byte[]~
    }
    class ParcelQueryService {
        +findForCaller(parcelId, caller) Parcel
    }
    class ParcelAccessPolicy {
        +canRead(caller, parcel) boolean
    }
    class ReceiptPdfGenerator {
        +render(parcel, history) byte[]
    }
    class ParcelRepository {
        <<port>>
        +findById(id)
    }
    ParcelController --> ParcelQueryService
    ParcelQueryService --> ParcelAccessPolicy
    ParcelQueryService --> ParcelRepository
    ParcelController --> ReceiptPdfGenerator
