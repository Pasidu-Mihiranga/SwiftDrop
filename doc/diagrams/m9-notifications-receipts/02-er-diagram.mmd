%% M9 data model: MongoDB database notifications (notification-service) and the receipt source in parcels_db.
erDiagram
    NOTIFICATIONS {
        string _id PK
        string userId "indexed"
        string parcelId
        string trackingNumber
        string type "event type"
        string title
        string body
        boolean read
        date createdAt
    }
    NOTIFICATION_PREFERENCES {
        string userId PK
        boolean email
        boolean sms
        string[] statuses "alerts opted in"
        date updatedAt
    }
    NOTIFICATION_LOGS {
        string _id PK
        string eventId
        string channel "EMAIL or SMS"
        string recipientMasked
        string status "SENT or FAILED"
        date sentAt
    }
    SMS_OUTBOX {
        string _id PK
        string phoneMasked
        string message
        string trackingNumber
        date createdAt
    }
    CONSUMER_IDEMPOTENCY {
        string _id PK "consumer:eventId"
        date processedAt "TTL"
    }
    PARCEL_CONTACTS {
        string parcelId PK
        string senderEmail
        string recipientPhone
        string trackingNumber
    }
    PARCEL {
        uuid id PK "parcels_db"
        string tracking_number
        decimal fee
        string status
    }
    PARCEL_CONTACTS ||--o{ NOTIFICATIONS : "addresses"
    NOTIFICATION_PREFERENCES ||--o{ NOTIFICATIONS : "filters"
    NOTIFICATIONS ||--o{ NOTIFICATION_LOGS : "sent as"
    NOTIFICATION_LOGS ||--o| SMS_OUTBOX : "SMS copy"
    PARCEL ||--o| PARCEL_CONTACTS : "projected from ParcelCreated"
