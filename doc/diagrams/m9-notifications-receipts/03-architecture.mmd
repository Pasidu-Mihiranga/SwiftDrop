%% M9 architecture: client, transport, application and data tiers.
flowchart TB
    subgraph CL["Client tier"]
        BELL["Notification bell and preferences<br/>Next.js"]
        HIST["Delivery history and receipts<br/>Next.js"]
        INBOX["Admin SMS inbox<br/>Next.js"]
    end
    subgraph TR["Transport tier"]
        BFF["Next.js BFF<br/>adds the bearer token"]
        GW["Spring Cloud Gateway<br/>JWT validation and routing"]
    end
    subgraph AP["Application tier"]
        NS["notification-service<br/>NestJS · 4 Kafka consumers<br/>channel strategy: e-mail and SMS<br/>Handlebars templates"]
        PS["parcel-service<br/>history queries<br/>OpenPDF receipt"]
    end
    subgraph DA["Data and infrastructure"]
        MDB[("MongoDB<br/>notifications")]
        KF[("Kafka<br/>parcel and merchant topics")]
        PG[("PostgreSQL<br/>parcels_db")]
        MP[("Mailpit SMTP<br/>e-mail in development")]
    end
    BELL --> BFF
    HIST --> BFF
    INBOX --> BFF
    BFF --> GW
    GW --> NS
    GW --> PS
    KF -- "consume" --> NS
    NS --> MDB
    NS -- "SMTP" --> MP
    PS --> PG
    PS -- "outbox relay" --> KF
