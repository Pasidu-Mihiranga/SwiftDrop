%% M9 class diagram: channel strategy in notification-service.
classDiagram
    direction LR
    class NotificationConsumer {
        +onMessage(event)
        -handleParcelEvent(event)
        -handleMerchantEvent(event)
    }
    class NotificationDispatcherService {
        +dispatch(event, contacts, prefs)
        -channelsFor(prefs)
    }
    class NotificationChannel {
        <<interface>>
        +name
        +send(message) Promise
    }
    class EmailChannel {
        +send(message)
    }
    class MockSmsChannel {
        +send(message)
    }
    class TemplateService {
        +render(type, data) string
    }
    class DatabaseService {
        +notifications()
        +preferences()
        +smsOutbox()
        +logs()
        +idempotency()
    }
    NotificationConsumer --> NotificationDispatcherService
    NotificationDispatcherService --> NotificationChannel
    NotificationChannel <|.. EmailChannel
    NotificationChannel <|.. MockSmsChannel
    NotificationDispatcherService --> TemplateService
    NotificationConsumer --> DatabaseService
    NotificationDispatcherService --> DatabaseService
