// Grafana Alloy — single collector for logs (→ Loki) and traces (→ Tempo).

// ---------------------------------------------------------------- Logs
// Discover every container of the compose project and tail its stdout/stderr.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  // Only containers of this compose project (other stacks on the same Docker host are ignored).
  filter {
    name   = "label"
    values = ["com.docker.compose.project=swiftdrop"]
  }
}

discovery.relabel "containers" {
  targets = []

  // Only this compose project (ignore other stacks running on the same Docker host).
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "swiftdrop"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.swiftdrop.receiver]
}

// SwiftDrop services log one JSON object per line (see libs/*/logging).
// Promote the level to a label and keep trace/correlation ids as structured metadata
// so Grafana can jump from a log line to its Tempo trace.
loki.process "swiftdrop" {
  stage.json {
    expressions = {
      level          = "level",
      trace_id       = "traceId",
      correlation_id = "correlationId",
    }
  }

  stage.labels {
    values = { level = "" }
  }

  stage.structured_metadata {
    values = {
      trace_id       = "",
      correlation_id = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------- Traces
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
