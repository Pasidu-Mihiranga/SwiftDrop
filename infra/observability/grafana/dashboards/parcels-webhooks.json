{
  "uid": "swiftdrop-parcels-webhooks",
  "title": "SwiftDrop - Bookings, courier ops and webhooks",
  "description": "M3 bookings, M4 status lifecycle and M8 webhook deliveries.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "swiftdrop",
    "m3",
    "m4",
    "m8"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "M3 Customer booking (parcel-service)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Parcels booked per hour, by channel",
      "description": "parcel_bookings_total: customer bookings and merchant API orders that created a parcel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (increase(parcel_bookings_total[1h]))",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Quote rejections at booking (per 5 min), by reason",
      "description": "expired: unknown or past expiry (422 QUOTE_EXPIRED); mismatch: priced for another route; pricing_unavailable: 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(parcel_quote_rejections_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Pricing circuit breaker",
      "description": "State of parcel-service's breaker around pricing-service calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(parcel_pricing_circuit_state)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Half open",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Open",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "Other",
                  "color": "purple",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "M4 Courier ops and status lifecycle (parcel-service)",
      "collapsed": false,
      "panels": [],
      "id": 5,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Status changes per hour, by status reached",
      "description": "parcel_status_changes_total: committed changes, including customer cancellations.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(parcel_status_changes_total[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "bargauge",
      "title": "Failed deliveries by reason (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "parcel_delivery_failures_total, from the reason the courier gave.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(parcel_delivery_failures_total[24h]))",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 10
      }
    },
    {
      "type": "stat",
      "title": "Delivered (24 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(parcel_status_changes_total{status=\"delivered\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 8,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 10
      }
    },
    {
      "type": "stat",
      "title": "Failed (24 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(parcel_status_changes_total{status=\"failed\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 9,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 14
      }
    },
    {
      "type": "row",
      "title": "M8 Webhook deliveries (webhook-service)",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Delivery attempts (per 5 min), by outcome",
      "description": "delivered: 2xx; retry: failed with attempts left; dead: dead-lettered; held: merchant suspended.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(webhook_delivery_attempts_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Endpoint answer time",
      "description": "Time until the merchant endpoint answered, or the timeout.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(webhook_delivery_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(webhook_delivery_latency_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 19
      }
    },
    {
      "type": "stat",
      "title": "Success rate (1 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(webhook_delivery_attempts_total{outcome=\"delivered\"}[1h])) / clamp_min(sum(increase(webhook_delivery_attempts_total{outcome=~\"delivered|retry|dead\"}[1h])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 13,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 19
      }
    },
    {
      "type": "stat",
      "title": "Dead-lettered (24 h)",
      "description": "Replay these from Admin, Webhooks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(webhook_delivery_attempts_total{outcome=\"dead\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 14,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 23
      }
    }
  ]
}
