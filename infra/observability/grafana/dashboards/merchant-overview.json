{
  "uid": "swiftdrop-merchants",
  "title": "SwiftDrop – Merchants & Merchant API (M7)",
  "description": "Business view of M7: merchant onboarding in merchant-service and the merchant order API in parcel-service. Meters come from MicrometerMerchantMetrics (merchant.status.changes, merchant.applications, merchant.credential.rotations) and MicrometerMerchantOrderMetrics (parcel.merchant.orders), plus the standard Spring Boot HTTP timer and kafka-exporter. Prometheus already scrapes both services under the java-services job. See doc/m7-monitoring.md.",
  "tags": [
    "swiftdrop",
    "merchant",
    "m7"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Merchant onboarding (merchant-service)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "New applications (selected range)",
      "description": "merchant_status_changes_total{to=\"PENDING\"}: applications stored, including re-applications after a rejection. Counted after the transaction commits, so a refused or rolled-back application is never counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(merchant_status_changes_total{to=\"PENDING\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Approvals (selected range)",
      "description": "Applications approved. Counted only after Keycloak provisioning succeeded and the approval committed; a Keycloak failure (503) leaves the merchant PENDING and is not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(merchant_status_changes_total{to=\"APPROVED\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejections (selected range)",
      "description": "Applications turned down with a reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(merchant_status_changes_total{to=\"REJECTED\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Suspensions (selected range)",
      "description": "Approved merchants suspended. Their API orders are refused once parcel-service has read the event.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(merchant_status_changes_total{to=\"SUSPENDED\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Applications by status (now)",
      "description": "merchant_applications gauge, read from merchant-service's database at most every 30 s. Rejected applications are kept as history, so an owner who applied again counts once as REJECTED and once in their current status. Shows no value (not 0) if the database could not be read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (merchant_applications)",
          "instant": true,
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Onboarding activity (per hour)",
      "description": "Status changes per hour by new status: PENDING are new applications, the others are admin decisions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (to) (increase(merchant_status_changes_total[1h]))",
          "legendFormat": "{{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "API credential rotations (selected range)",
      "description": "Client secrets replaced by merchants (POST /api/v1/merchants/me/credentials/rotate). Counted after Keycloak issued the new secret; failed rotations are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(merchant_credential_rotations_total[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Merchant order API (parcel-service)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Orders created (selected range)",
      "description": "parcel_merchant_orders_total{outcome=\"created\"}: new parcels stored through POST /api/v1/merchant/orders, counted after the order transaction committed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(parcel_merchant_orders_total{outcome=~\"created\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Idempotent replays (selected range)",
      "description": "Retries with the same Idempotency-Key and body, answered with the original parcel (200, Idempotent-Replayed: true). Includes a request that lost a race to an identical one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(parcel_merchant_orders_total{outcome=~\"replayed\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Idempotency conflicts (selected range)",
      "description": "The same Idempotency-Key with a different body (409 IDEMPOTENCY_KEY_REUSED), plus a key whose first request had not finished (409 IDEMPOTENCY_KEY_IN_PROGRESS).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(parcel_merchant_orders_total{outcome=~\"idempotency_conflict|idempotency_in_progress\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Successful order requests (selected range)",
      "description": "Created or replayed, out of every order request that reached the order logic. With no order requests in the range it shows no value rather than 0%. Requests refused earlier (missing token or role, invalid body or Idempotency-Key) are in the HTTP panel below instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(parcel_merchant_orders_total{outcome=~\"created|replayed\"}[$__range])) / (sum(increase(parcel_merchant_orders_total[$__range])) > 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Order requests by outcome (per min)",
      "description": "Every request that reached the order logic, by how it ended: created, replayed, idempotency_conflict, idempotency_in_progress, not_approved, no_merchant, not_priceable, pricing_unavailable, failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(parcel_merchant_orders_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "POST /api/v1/merchant/orders responses by HTTP status (per min)",
      "description": "Spring Boot's standard HTTP metric. Unlike the outcome panel it also shows requests refused before the order logic: 400 (invalid body or Idempotency-Key), 401 and 403 (token or role).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{service=\"parcel-service\", uri=\"/api/v1/merchant/orders\", method=\"POST\"}[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Refused order requests by reason (per min)",
      "description": "not_approved: the merchant is not APPROVED or parcel-service has not seen it approved. not_priceable: pricing-service refused the order (422). pricing_unavailable: pricing-service unreachable or its circuit open (503). failed: anything else, such as a database error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(parcel_merchant_orders_total{outcome!~\"created|replayed\"}[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Idempotency: replays and conflicts (per min)",
      "description": "A steady stream of replays usually means a merchant's system retries on timeouts, which is safe. Conflicts mean it reuses one key for different orders, which is a client bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(parcel_merchant_orders_total{outcome=\"replayed\"}[5m])) * 60",
          "legendFormat": "replayed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(parcel_merchant_orders_total{outcome=~\"idempotency_conflict|idempotency_in_progress\"}[5m])) * 60",
          "legendFormat": "conflict"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "stat",
      "title": "merchant-service up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether Prometheus can scrape merchant-service's /actuator/prometheus (the standard up metric).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{service=\"merchant-service\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "parcel-service up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether Prometheus can scrape parcel-service's /actuator/prometheus (the standard up metric).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{service=\"parcel-service\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "M7 endpoints 5xx ratio (5m)",
      "description": "Share of merchant onboarding and merchant order API requests that failed on the server, over the last 5 minutes: 0 when there was traffic and nothing failed, no value when there was no traffic. A 503 from Keycloak during approval, or from pricing-service during an order, counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 8,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{service=~\"merchant-service|parcel-service\", uri=~\"/api/v1/(merchants|admin/merchants|merchant/orders).*\", status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{service=~\"merchant-service|parcel-service\", uri=~\"/api/v1/(merchants|admin/merchants|merchant/orders).*\"}[5m])) > 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Merchant lifecycle consumer lag",
      "description": "Lifecycle events parcel-service has not read yet (kafka-exporter). While it is above 0 an approval or suspension has not reached the order API, so a newly approved merchant may still get 403. kafka-exporter reports -1 for a partition with no committed offset yet (for example one that never received an event); those partitions are left out rather than summed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 13,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"parcel-service\", topic=\"swiftdrop.merchant.lifecycle.v1\"} >= 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
      "id": 23,
