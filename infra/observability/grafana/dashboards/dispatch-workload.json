{
  "uid": "swiftdrop-dispatch",
  "title": "SwiftDrop - Dispatch consumer lag",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "swiftdrop",
    "m5",
    "kafka"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Dispatch consumer lag by topic",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=\"dispatch-service\"})",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dispatch service up",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service=\"dispatch-service\"}"
        }
      ]
    }
  ]
}
