        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "429 Rate limited",
      "description": "Requests refused by the Redis rate limiter, in the selected range.",
      "gridPos": {
        "h": 5,
