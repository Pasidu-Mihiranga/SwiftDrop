    {
      "type": "timeseries",
      "title": "Rejected requests per second",
      "description": "401 and 403 come from authentication and roles, 429 from rate limiting, 503 from a service that is down.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{service=\"api-gateway\",status=~\"401|403|429|503\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
