<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven aggregator for every Java module in the monorepo.
  Build everything:            mvn verify
  Build one service + libs:    mvn -pl services/parcel-service -am verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>lk.swiftdrop</groupId>
    <artifactId>swiftdrop-build</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SwiftDrop :: Build</name>

    <modules>
        <!-- Shared libraries -->
        <module>libs/java/swiftdrop-parent</module>
        <module>libs/java/swiftdrop-common-logging</module>
        <module>libs/java/swiftdrop-common-web</module>
        <module>libs/java/swiftdrop-common-security</module>
        <module>libs/java/swiftdrop-events</module>
        <module>libs/java/swiftdrop-outbox</module>

        <!-- Services -->
        <module>services/api-gateway</module>
        <module>services/user-service</module>
        <module>services/merchant-service</module>
        <module>services/pricing-service</module>
        <module>services/parcel-service</module>
        <module>services/dispatch-service</module>
        <module>services/reporting-service</module>
    </modules>
</project>
